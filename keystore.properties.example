# Release signing configuration — TEMPLATE.
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill in
# your own values. `app/build.gradle.kts` reads `keystore.properties` from the
# repository root; when the file is absent, `assembleRelease` falls back to the
# debug key and prints a warning, so local release-ish builds still work.
#
# NEVER commit `keystore.properties` or the keystore itself.
#
#   cp keystore.properties.example keystore.properties
#   keytool -genkeypair -v \
#     -keystore release.jks -alias opencode \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Losing the keystore means you can no longer ship updates to an installed app.

storeFile=release.jks
storePassword=change-me
keyAlias=opencode
keyPassword=change-me
